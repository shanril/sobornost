# Maintainer: Your Name <your@email.com>

pkgname=sobornost-git
_pkgname=sobornost
pkgver=0.1.0
pkgrel=1
pkgdesc="Linux-native EVE Online client preview and switcher"
arch=('x86_64')
url="https://github.com/yourusername/sobornost"
license=('MIT')
depends=(
  'python'
  'python-pillow'
  'python-pyside6'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
  'git'
  'libxcb'
  'xcb-util'
  'xcb-util-image'
  'xcb-util-keysyms'
  'xcb-util-wm'
)
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+${url}")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_pkgname}"
  git describe --long --tags 2>/dev/null \
    | sed 's/\([^-]*-g\)/r\1/;s/-/./g' \
    || echo "r0.$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${_pkgname}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/${_pkgname}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
